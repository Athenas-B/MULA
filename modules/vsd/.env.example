# VSD Server Configuration
# Copy to .env and adjust values for your system.
# Variables already set in the environment (e.g. by MULA) take precedence over .env.

# Where downloaded videos are saved
VSD_DOWNLOAD_DIR=~/Downloads/VSD

# Path to ffmpeg binary (auto-detected if on PATH)
# VSD_FFMPEG=/usr/bin/ffmpeg

# Server bind address
VSD_HOST=127.0.0.1
# Server port (default 8765). MULA passes this when it starts the server.
VSD_PORT=8765

# Auto-open downloaded files (0 or 1)
VSD_AUTO_OPEN=0

# Retry count for failed segment downloads (attempts per segment)
VSD_MAX_RETRIES=3

# Segments downloaded in parallel per job (1-16, default 6)
# VSD_SEGMENT_WORKERS=6

# Secret that authorizes POST /config/download_dir: the request must send it in the
# X-VSD-Admin-Token header. MULA generates a fresh random token on every launch and
# passes it in the environment, so it normally does NOT belong in .env. If it is
# unset or empty, changing the download directory is disabled (always 403).
# VSD_ADMIN_TOKEN=
