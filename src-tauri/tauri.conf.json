{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MULA",
  "identifier": "com.athenas-b.mula",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MULA",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../modules/vsd/server.py": "modules/vsd/server.py",
      "../modules/vsd/requirements.txt": "modules/vsd/requirements.txt",
      "../modules/vsd/.env.example": "modules/vsd/.env.example",
      "../modules/vsd/extension/build.py": "modules/vsd/extension/build.py",
      "../modules/vsd/extension/chrome/": "modules/vsd/extension/chrome/",
      "../modules/vsd/extension/firefox/": "modules/vsd/extension/firefox/",
      "../modules/vsd/extension/src/": "modules/vsd/extension/src/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
